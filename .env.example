# Copiar como `.env` y completar los valores.
# En Vercel: Settings -> Environment Variables con estos MISMOS nombres.

# URL del proyecto de Supabase (Settings -> API -> Project URL).
VITE_SUPABASE_URL=

# Clave anon pública (Settings -> API -> anon public). Es pública; jamás la secreta.
VITE_SUPABASE_ANON_KEY=

# URL pública de la app, usada para armar el QR de la sala.
# Local: http://localhost:5173  |  Producción: https://mi-app.vercel.app
VITE_APP_URL=

# (Opcional) WhatsApp global que recibe los códigos de verificación de los
# jugadores cuando la sala no configuró el suyo en el panel. Formato: +54 9 11 5555-1234
VITE_WHATSAPP_ANFITRION=
